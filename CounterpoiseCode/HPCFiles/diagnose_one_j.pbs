#!/bin/bash
#PBS -N DiagnoseJ
#PBS -l walltime=1:00:00
#PBS -l select=1:ncpus=1:mem=16GB
# Submit e.g.:
#   qsub -v ROOT=$EPHEMERAL/outputs_cp/Y6_20000ps_5A,DIMERS="Mol116_Lattice0_Mol162_Lattice0_20000ps Mol192_Lattice0_Mol203_Lattice0_20000ps" diagnose_one_j.pbs
# Result: $ROOT/<dimer>/J_diagnosis.npz for each dimer

eval "$($HOME/miniforge3/bin/conda shell.bash hook)"
conda activate msci
python $HOME/MSci/CounterpoiseCode/HPCFiles/DiagnoseOneJ.py $ROOT $DIMERS