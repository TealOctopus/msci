#!/bin/bash
#PBS -N CP_Ts
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=8:mem=40GB

RUN_NAME="${MOL}_${T}ps_${CUTOFF}A"

eval "$($HOME/miniforge3/bin/conda shell.bash hook)"
conda activate msci
export OMP_NUM_THREADS=1

# Commands for program I want to run
cd $PBS_O_WORKDIR
python CalcJs.py $RUN_NAME
