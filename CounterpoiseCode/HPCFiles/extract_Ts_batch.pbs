#!/bin/bash
#PBS -N CP_Ts
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=8:mem=10GB

MOL="L8BO"
PBC=1

eval "$($HOME/miniforge3/bin/conda shell.bash hook)"
conda activate msci

# Commands for program I want to run
cd $PBS_O_WORKDIR
cp CalcJs.py $EPHEMERAL
cp CounterpoiseJarvVersion.py $EPHEMERAL
cd $EPHEMERAL
python CalcJs.py $MOL $PBC
